
import { createClient } from "npm:@supabase/supabase-js@2";

const corsHeaders = {
  "Access-Control-Allow-Origin": "*",
  "Access-Control-Allow-Headers":
    "authorization, x-client-info, apikey, content-type",
  "Access-Control-Allow-Methods": "POST, OPTIONS",
};

function jsonResponse(data: unknown, status = 200) {
  return new Response(JSON.stringify(data), {
    status,
    headers: {
      ...corsHeaders,
      "Content-Type": "application/json",
    },
  });
}

Deno.serve(async (req: Request) => {
  if (req.method === "OPTIONS") {
    return new Response("ok", { headers: corsHeaders });
  }

  if (req.method !== "POST") {
    return jsonResponse(
      { success: false, error: "Method tidak diizinkan." },
      405,
    );
  }

  try {
    // 1. Ambil konfigurasi server
    const supabaseUrl = Deno.env.get("SUPABASE_URL")!;
    const supabaseKey =
      Deno.env.get("SUPABASE_ANON_KEY") ||
      Deno.env.get("SUPABASE_PUBLISHABLE_KEY");

    const biteshipKey = Deno.env.get("BITESHIP_API_KEY");

    if (!supabaseUrl || !supabaseKey || !biteshipKey) {
      console.error("Konfigurasi Edge Function belum lengkap.");
      return jsonResponse(
        { success: false, error: "Konfigurasi server belum lengkap." },
        500,
      );
    }

    // 2. Validasi token login Supabase
    const authHeader = req.headers.get("Authorization");

    if (!authHeader?.startsWith("Bearer ")) {
      return jsonResponse(
        { success: false, error: "Silakan login terlebih dahulu." },
        401,
      );
    }

    const supabase = createClient(supabaseUrl, supabaseKey, {
      global: {
        headers: {
          Authorization: authHeader,
        },
      },
      auth: {
        persistSession: false,
        autoRefreshToken: false,
      },
    });

    const token = authHeader.substring(7);
    const { data: userData, error: userError } =
      await supabase.auth.getUser(token);

    if (userError || !userData.user) {
      return jsonResponse(
        { success: false, error: "Sesi login tidak valid." },
        401,
      );
    }

    // 3. Pastikan pengguna adalah admin Baylos
    const { data: isAdmin, error: adminError } =
      await supabase.rpc("is_baylos_admin");

    if (adminError || isAdmin !== true) {
      return jsonResponse(
        { success: false, error: "Akses hanya untuk administrator." },
        403,
      );
    }

    // 4. Baca kata kunci pencarian
    let body: { query?: unknown };

    try {
      body = await req.json();
    } catch {
      return jsonResponse(
        { success: false, error: "Format permintaan tidak valid." },
        400,
      );
    }

    const query = String(body?.query ?? "").trim();

    if (query.length < 2) {
      return jsonResponse(
        {
          success: false,
          error: "Masukkan minimal 2 karakter nama daerah atau kode pos.",
        },
        400,
      );
    }

    if (query.length > 100) {
      return jsonResponse(
        { success: false, error: "Kata kunci maksimal 100 karakter." },
        400,
      );
    }

    // 5. Cari area melalui Biteship
    const params = new URLSearchParams({
      countries: "ID",
      input: query,
      type: "single",
    });

    const biteshipResponse = await fetch(
      `https://api.biteship.com/v1/maps/areas?${params.toString()}`,
      {
        method: "GET",
        headers: {
          Authorization: biteshipKey,
          "Content-Type": "application/json",
        },
      },
    );

    const responseText = await biteshipResponse.text();

    let biteshipData: Record<string, unknown>;

    try {
      biteshipData = JSON.parse(responseText);
    } catch {
      console.error(
        "Biteship mengembalikan respons yang bukan JSON. Status:",
        biteshipResponse.status,
      );

      return jsonResponse(
        { success: false, error: "Respons dari layanan Biteship tidak valid." },
        502,
      );
    }

    if (!biteshipResponse.ok) {
      console.error(
        "Biteship API gagal. Status:",
        biteshipResponse.status,
      );

      return jsonResponse(
        {
          success: false,
          error: "Pencarian area Biteship gagal. Periksa konfigurasi layanan.",
        },
        502,
      );
    }

    // 6. Kirim hasil pencarian ke browser
    const areas = Array.isArray(biteshipData.areas)
      ? biteshipData.areas
      : [];

    return jsonResponse({
      success: true,
      query,
      count: areas.length,
      areas,
    });
  } catch (error) {
    console.error(
      "search-biteship-area error:",
      error instanceof Error ? error.message : "Unknown error",
    );

    return jsonResponse(
      { success: false, error: "Terjadi kesalahan pada server." },
      500,
    );
  }
});
